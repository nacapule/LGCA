<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Alpha — experiment results</title>
<style>
:root{color-scheme:light;--bg:#fcfcfa;--ink:#19252d;--muted:#5a676c;--line:#dce1dd;--accent:#166a80}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,sans-serif}main{max-width:1050px;margin:auto;padding:24px 28px}h1{font-size:27px;line-height:1.2;margin:6px 0 12px;font-weight:650}h2{font-size:18px;margin:0}h3{font-size:15px;margin:0}a{color:var(--accent);text-underline-offset:3px}small,.muted{color:var(--muted)}header{margin-bottom:20px}.topline,.toolbar,.snapshot-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.topline{font-size:12px}.settings{display:flex;gap:6px 20px;flex-wrap:wrap;color:var(--muted);font-size:12px}.toolbar{border-block:1px solid var(--line);padding:10px 0}.controls{display:flex;gap:16px;flex-wrap:wrap;align-items:center}label{display:inline-flex;align-items:center;gap:7px;font-size:13px}select,button{font:inherit;color:inherit;background:var(--bg);border:1px solid #c6cfcc;border-radius:5px;padding:5px 8px}select{font-size:13px}button{cursor:pointer}.switch{display:flex;gap:4px}.switch button{font-size:13px;border-color:transparent}.switch button[aria-pressed=true]{background:#e5eeec;color:#185362;font-weight:650}button:focus-visible,a:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}figure{margin:0}img.figure{display:block;width:100%;max-width:830px;height:auto;margin:16px auto 8px}.chart-link{display:block}.chart-link:focus-visible{outline-offset:0}details{padding:10px 0;border-top:1px solid var(--line);font-size:13px}summary{cursor:pointer;color:var(--muted)}.table-controls{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:14px 0 5px}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums;font-size:13px}td,th{padding:8px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}td:first-child,th:first-child{text-align:left}.spread{color:var(--muted);font-size:11px;margin-left:5px}.snapshots{border-top:1px solid var(--line);margin-top:16px;padding-top:20px}.snaps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:16px}.snap-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:8px}.snap-head a{font-size:11px}.snap img{display:block;width:100%;aspect-ratio:1/.8660254;image-rendering:pixelated;background:#0b0e13;border-radius:3px}.snap figcaption{display:flex;justify-content:space-between;gap:5px;color:var(--muted);font-size:11px;margin-top:6px}.snap figcaption b{color:var(--ink);font-weight:600}.scale{display:flex;align-items:center;gap:12px;margin-top:14px;font-size:11px;color:var(--muted)}.scale-bar{width:220px;height:9px;border:1px solid #dce1dd;background:linear-gradient(to right,/*DENSITY_GRADIENT*/)}.scale-ticks{position:relative;height:16px;font-size:10px;margin-top:3px}.scale-ticks span{position:absolute;transform:translateX(-50%)}.scale-ticks span:first-child{transform:none}.scale-ticks span:last-child{transform:translateX(-100%)}.empty-key{display:inline-block;width:8px;height:8px;background:#0b0e13;margin-right:4px}footer{display:flex;gap:16px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:24px;padding-top:12px;font-size:12px;color:var(--muted)}footer a{color:var(--muted)}
@media(max-width:680px){main{padding:18px 14px}h1{font-size:24px}.snaps{grid-template-columns:repeat(2,minmax(0,1fr))}.settings{gap:4px 12px}.spread{display:block}td,th{padding:8px 5px}.scale{flex-wrap:wrap}.snapshot-head{align-items:flex-start}img.figure{margin-block:14px}.controls{gap:10px}}
</style>
<main>
<header>
  <div class="topline"><span>LGCA · 25 Sep 2026</span><a id="labLink" href="../../lgca-viz/lgca-lab.html">Open Lab ↗</a></div>
  <h1>Alpha &amp; cluster density</h1>
  <label style="margin-bottom:10px">Compare <select id="study"><option value="size">Box sizes · neighbours only</option><option value="density" disabled>Mean densities · site + neighbours (running)</option></select></label>
  <div id="settings" class="settings"></div>
</header>
<section aria-label="Cluster density plots">
  <div class="toolbar">
    <div class="switch" role="group" aria-label="Plot view"><button id="viewTime" aria-pressed="true">Density vs time</button><button id="viewSize" aria-pressed="false">Density vs size</button></div>
    <div class="controls"><label id="alphaControl">Alpha <select id="alpha"><option value="0.75">0.75</option><option value="0.8" selected>0.80</option><option value="0.85">0.85</option><option value="0.9">0.90</option></select></label><label id="focusControl">Time view <select id="focus"><option value="focus" selected>Early rise + full run</option><option value="full">Full run</option></select></label><label>Through step <select id="time"></select></label></div>
  </div>
  <a id="plotLink" class="chart-link" aria-label="Open plot PDF"><img id="plot" class="figure" alt="Cluster density versus system size, mean and standard deviation across five seeds"></a>
  <details>
    <summary>Numbers</summary>
    <div class="table-controls"><label>Measurement <select id="metric"><option value="clusterDensity">Cluster density · particles/site</option><option value="clusterMass">Cluster mass · particles</option><option value="clusterArea">Cluster area · sites</option><option value="clusterFraction">Cluster mass / total particles</option><option value="siteFraction">Densest site / total particles</option><option value="channelFraction">Densest site-channel / total particles</option></select></label><small id="tableNote"></small></div>
    <div class="scroll"><table id="numbers"></table></div>
  </details>
</section>
<section class="snapshots" aria-label="Density snapshots">
  <div class="snapshot-head"><h2>Snapshots <small id="snapTime"></small></h2><div class="controls"><label id="sizeControl">Size <select id="size"><option value="90">90 × 90</option><option value="120">120 × 120</option><option value="180" selected>180 × 180</option></select></label><label>Seed <select id="seed"><option>12345</option><option>777</option><option>424242</option><option>20260925</option><option>314159</option></select></label></div></div>
  <div id="snaps" class="snaps"></div>
  <div class="scale"><span>Particles/site · log scale</span><span><i class="empty-key"></i>0</span><div><div class="scale-bar"></div><div class="scale-ticks"><span style="left:0">1</span><span style="left:27.4%">10</span><span style="left:63.1%">100</span><span style="left:100%">1000+</span></div></div></div>
</section>
<footer><span>Cluster density = mass / area</span><a id="methodsLink" href="METHODS.md">Methods</a><a id="dataLink" href="measurements.csv">Data</a><a id="validationLink" href="validation.json">Validation</a></footer>
</main>
<script>
const DATA=/*DATA*/,DENSITY=/*DENSITY_DATA*/;
const $=id=>document.getElementById(id);
const STUDIES={size:{data:DATA,alphas:[.75,.8,.85,.9],columns:[90,120,180],key:'size',root:'.',field:'neigh'},density:{data:DENSITY,alphas:[.8,.9,1],columns:[.1,.2,.4,.8],key:'dens',root:'../density-2026-09-25',field:'both'}};
let view='time';
const study=()=>STUDIES[$('study').value],isDensity=()=>$('study').value==='density';
if(DENSITY){const o=$('study').querySelector('[value="density"]');o.disabled=false;o.textContent='Mean densities · site + neighbours';$('study').value='density';}
function table(key){const s=study();return '<thead><tr><th scope="col">Alpha</th>'+s.columns.map(x=>`<th scope="col">${isDensity()?`Mean ≈ ${(6*x).toFixed(1)}`:`${x} × ${x}`}</th>`).join('')+'</tr></thead><tbody>'+s.alphas.map(a=>'<tr><th scope="row">'+a.toFixed(2)+'</th>'+s.columns.map(x=>{const v=s.data.groups.find(g=>g[s.key]===x&&g.alpha===a).checkpoints.find(m=>m.t===+$('time').value).lateWindow[key],fraction=key.includes('Fraction'),f=fraction?100:1;return `<td>${(v.mean*f).toFixed(fraction?2:1)}${fraction?'%':''}<span class="spread">± ${(v.sd*f).toFixed(fraction?2:1)}${fraction?'%':''}</span></td>`;}).join('')+'</tr>').join('')+'</tbody>';}
function snapshots(){const s=study(),L=isDensity()?90:+$('size').value,seed=+$('seed').value,t=+$('time').value,a=+$('alpha').value;$('snapTime').textContent=`· ${isDensity()?`α = ${a.toFixed(2)} · `:''}step ${t.toLocaleString()}`;const conditions=isDensity()?s.columns.map(dens=>({alpha:a,dens})):s.alphas.map(alpha=>({alpha,dens:.4}));$('snaps').innerHTML=conditions.map(({alpha,dens})=>{const r=s.data.runs.find(r=>r.job.size===L&&r.job.alpha===alpha&&r.job.dens===dens&&r.job.seed===seed),m=r.snaps.find(m=>m.t===t),src=`${s.root}/images/${r.job.id}-t${t}.png`;return `<article class="snap"><div class="snap-head"><h3>${isDensity()?`Mean ≈ ${(6*dens).toFixed(1)}`:`α = ${alpha.toFixed(2)}`}</h3><a href="../../lgca-viz/lgca-lab.html?study=alpha&alpha=${alpha}&size=${L}&seed=${seed}&dens=${dens}&field=${s.field}" title="Start a fresh simulation with these settings">Lab ↗</a></div><figure><a href="${src}" title="Open full snapshot"><img src="${src}" alt="Density at alpha ${alpha}, mean input ${(6*dens).toFixed(1)} particles/site, ${s.field} field, size ${L}, seed ${seed}, step ${t}"></a><figcaption><span>Cluster density <b>${m.clusterDensity.toFixed(1)}</b></span><span>particles/site</span></figcaption></figure></article>`;}).join('');}
function drawPlot(){const s=study(),t=$('time').value,a=$('alpha').value,src=view==='time'?`${s.root}/figures/density-time-${$('focus').value==='focus'?'focus-':''}a${a}-t${t}`:`${s.root}/figures/density-size-t${t}`;$('plot').src=src+'.png';$('plotLink').href=src+'.pdf';$('plot').alt=view==='time'?`Alpha ${a}: cluster density versus time, comparing ${isDensity()?'four mean densities at fixed 90 by 90 size':'three box sizes at fixed mean density'}, through step ${t}, mean and standard deviation across five seeds${$('focus').value==='focus'?'; early 0–5000 view above full run':''}`:`Late cluster density versus ${isDensity()?'mean system density':'box size'}, mean and standard deviation across five seeds`;$('focusControl').style.display=view==='time'?'inline-flex':'none';$('alphaControl').style.display=view==='time'?'inline-flex':'none';$('viewSize').setAttribute('aria-pressed',view==='size');$('viewTime').setAttribute('aria-pressed',view==='time');$('viewSize').textContent=isDensity()?'Late density':'Density vs size';$('labLink').href=`../../lgca-viz/lgca-lab.html?study=alpha&alpha=${a}&size=${isDensity()?90:180}&dens=0.4&field=${s.field}`;}
function draw(){const t=+$('time').value;$('numbers').innerHTML=table($('metric').value);$('tableNote').textContent=`Steps ${(t*.75+100).toLocaleString()}–${t.toLocaleString()} · mean ± SD`;drawPlot();snapshots();}
function changeStudy(){const s=study(),oldAlpha=+$('alpha').value,oldTime=+$('time').value;$('alpha').innerHTML=s.alphas.map(a=>`<option value="${a}">${a.toFixed(2)}</option>`).join('');$('alpha').value=s.alphas.includes(oldAlpha)?oldAlpha:.8;const times=s.data.groups[0].checkpoints.map(m=>m.t).filter(t=>t>=10000);$('time').innerHTML=times.map(t=>`<option value="${t}">${t.toLocaleString()}</option>`).join('');$('time').value=times.includes(oldTime)?oldTime:times.at(-1);$('sizeControl').style.display=isDensity()?'none':'inline-flex';$('settings').innerHTML=['Polar bosons',isDensity()?'Site + 6 neighbours':'6 neighbours · centre excluded','Sensitivity 6',isDensity()?'90 × 90 · mean density varied':'Density 0.4/channel · size varied','60 runs · 5 seeds/condition'].map(x=>`<span>${x}</span>`).join('');for(const [id,file] of [['methodsLink','METHODS.md'],['dataLink','measurements.csv'],['validationLink','validation.json']])$(id).href=s.root+'/'+file;draw();}
for(const [id,v] of [['viewSize','size'],['viewTime','time']])$(id).addEventListener('click',()=>{view=v;drawPlot();});
$('study').addEventListener('change',changeStudy);$('focus').addEventListener('change',drawPlot);$('alpha').addEventListener('change',()=>{drawPlot();snapshots();});$('time').addEventListener('change',draw);$('metric').addEventListener('change',()=>{$('numbers').innerHTML=table($('metric').value);});for(const id of ['size','seed'])$(id).addEventListener('change',snapshots);changeStudy();
</script>
</html>
